# Template for /etc/systemd/system/magicbox-device.service - installed and
# filled in by `make pi-service` (placeholders substituted with sed).
# Runs the daemon natively on the Pi: BLE + HDMI/DRM output, no Docker.
[Unit]
Description=MagicBox device daemon
After=bluetooth.target network.target dbus.service
Wants=bluetooth.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO_DIR@
Environment=MAGICBOX_TRANSPORT=ble
Environment=MAGICBOX_DEVICE_NAME=MagicBox
Environment=MAGICBOX_MOVIES_DIR=@MOVIES_DIR@
Environment=MAGICBOX_THUMBNAIL_DIR=@THUMBNAIL_DIR@
# Parses @MOVIES_DIR@ into the static library index (+ thumbnails) that
# magicbox-device loads at startup - runs fresh on every start/restart so
# newly dropped-in content is always picked up without a manual rescan step.
ExecStartPre=@REPO_DIR@/.venv/bin/magicbox-scan
ExecStart=@REPO_DIR@/.venv/bin/magicbox-device
Restart=on-failure
RestartSec=2

# DRM/KMS output + evdev keyboard input + BlueZ D-Bus - see `make pi-setup`,
# which adds @USER@ to these groups.
SupplementaryGroups=video input bluetooth

[Install]
WantedBy=multi-user.target
